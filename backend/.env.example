# Django
DJANGO_SECRET_KEY=replace-with-a-strong-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=dsa_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000

# macOS Homebrew GeoDjango libs (only needed if auto-detection fails)
# Leave commented for Linux/Windows and Docker containers.
# GDAL_LIBRARY_PATH=/opt/homebrew/opt/gdal/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/opt/geos/lib/libgeos_c.dylib

# API keys (required)
GOOGLE_MAPS_API_KEY=

# Classification thresholds (optional -- defaults shown)
CLASSIFY_THRESHOLD_REMOVED=0.25

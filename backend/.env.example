DJANGO_SECRET_KEY=replace-with-a-strong-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — matches POSTGRES_* env vars expected by settings.py and docker-compose
POSTGRES_DB=dsa_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000

# macOS Homebrew GeoDjango libs (only needed if auto-detection fails)
# Leave commented for Linux/Windows and Docker containers.
# GDAL_LIBRARY_PATH=/opt/homebrew/opt/gdal/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/opt/geos/lib/libgeos_c.dylib

# Optional API keys
OPENAI_API_KEY=
GOOGLE_EARTH_API_KEY=

# Classification thresholds
# Phase 2: IoU above this → "unchanged"
CLASSIFY_IOU_UNCHANGED=0.35

# Phase 2: IoU above this → "modified" (below → fallback checks)
CLASSIFY_IOU_MODIFIED_LOW=0.10

# SAM masks with confidence below this are discarded
CLASSIFY_SAM_CONFIDENCE_MIN=0.50

# Pixel padding around bounding box for SAM box prompt
CLASSIFY_BOX_PAD_PX=10

# Low-IoU fallback: if SAM polygon overlaps input by this ratio → "modified"
CLASSIFY_OVERLAP_RATIO_MIN=0.30

# Pixel analysis fallback: score above this → "modified" (below → "removed")
CLASSIFY_PIXEL_FALLBACK_MIN=0.50

# Phase 1: pixel score below this → "removed" without running SAM
CLASSIFY_THRESHOLD_REMOVED=0.25

# Pixel analysis scoring thresholds
CLASSIFY_BRIGHTNESS_MIN=60
CLASSIFY_BRIGHTNESS_MAX=220
CLASSIFY_COLOR_STD_LOW=40
CLASSIFY_COLOR_STD_HIGH=60
CLASSIFY_TEXTURE_STD_MIN=15
CLASSIFY_TEXTURE_STD_MAX=60
CLASSIFY_GREEN_RATIO_LOW=0.38
CLASSIFY_GREEN_RATIO_HIGH=0.42
CLASSIFY_SATURATION_LOW=0.3
CLASSIFY_SATURATION_HIGH=0.5

# Max attempts for satellite tile downloads (uses exponential backoff: 1s, 2s, ...)
CLASSIFY_TILE_DOWNLOAD_MAX_RETRIES=3

# Per-attempt timeout in seconds for satellite tile downloads
CLASSIFY_TILE_DOWNLOAD_TIMEOUT=15

# Max buildings sent through SAM (Phase 2). The most ambiguous buildings
# (lowest pixel score) are prioritised. Remainder use pixel-only fallback.
# Raise this for higher shape accuracy; lower it for faster results.
CLASSIFY_SAM_MAX_BUILDINGS=200
